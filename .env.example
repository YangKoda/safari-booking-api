# Application
NODE_ENV=development
PORT=3000

# Database (Phase 3)
DATABASE_URL=postgresql://user:password@localhost:5432/safari_booking_dev?schema=public

# Development Seed Password
SEED_USER_PASSWORD=admin123


# JWT (Phase 3)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Future - Phase 9)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email Configuration (Optional - can be disabled in development)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Safari Booking API

# AWS S3 File Storage (Phase 8)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
